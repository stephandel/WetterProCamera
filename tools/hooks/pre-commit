#!/bin/sh
# Git-Hook vor jedem Commit: Version des Service Workers neu berechnen und sw.js mit in den Commit nehmen.
# Einrichten einmal pro Rechner:  npm run hooks   (setzt git config core.hooksPath tools/hooks)
command -v node >/dev/null 2>&1 || { echo "pre-commit: Node fehlt, Version nicht aktualisiert."; exit 0; }
cd "$(git rev-parse --show-toplevel)" || exit 1
node tools/version.js || exit 1
git add sw.js
